<Project Sdk="Godot.NET.Sdk/4.7.0">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <LangVersion>14</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="addons\gdUnit4\**\*.cs"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1"/>
        <PackageReference Include="MSTest.TestAdapter" Version="4.3.2"/>
        <PackageReference Include="MSTest.TestFramework" Version="4.3.2"/>
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172"/>
        <PackageReference Include="SQLiteNetExtensions" Version="2.1.0"/>
    </ItemGroup>
    <!-- gdUnit4 package dependencies -->
    <ItemGroup>
        <PackageReference Include="gdUnit4.api" Version="5.1.0-rc1"/>
        <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0"/>
        <PackageReference Include="gdUnit4.analyzers" Version="1.0.0">
            <PrivateAssets>none</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Content Include="addons\EnumToIcon\EnumToStringDatabase\plugin.cfg"/>
    </ItemGroup>
    <ItemGroup>
        <Content Include="main\packages\model\Dna\Nuclei.db">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <None Include="main\packages\model\Dna\dna.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>packages\model\Dna\dna.sql</Link> <!-- Keeps original output directory structure -->
        </None>
    </ItemGroup>
    <ItemGroup>
        <Content Include="addons\EnumToIcon\EnumToStringDatabase\main\db_declaration.sql">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <None Update="addons\EnumToIcon\EnumToStringDatabase\main\enum_to_directory.db">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>

